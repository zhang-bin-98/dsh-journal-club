{
  "name": "dsh-journal-club",
  "version": "0.1.0",
  "description": "DeepSeek Harness 生物医学论文 Journal Club 汇报插件：论文解析、图源切分、叙事大纲与幻灯片分页",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src/skills/journal-club/SKILL.md",
    "src/tools/composePanels.ts",
    "src/layout/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": ["@deepseek-ai/dsh-api-gateway/client"]
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && tsdown --config tsdown.client.ts",
    "build:watch": "tsdown --config tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@tsdown/css": "^0.23.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.23.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
